{
  "version": 3,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "coverage-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "BUILD_TUTORIALS": "OFF",
        "ENABLE_SANITIZERS": "OFF",
        "ENABLE_COVERAGE": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_SANITIZERS": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS_RELEASE": "-O3 -march=native -DNDEBUG"
      }
    },
    {
      "name": "debug-tidy",
      "displayName": "Debug with clang-tidy",
      "inherits": "debug",
      "cacheVariables": {
        "ENABLE_CLANG_TIDY": "ON"
      }
    },
    {
      "name": "release-max",
      "displayName": "Release (max optimizations)",
      "description": "Aggressive floating-point optimizations. Use only when the model's numerical assumptions permit reassociation and reciprocal approximations.",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS_RELEASE": "-O3 -march=native -DNDEBUG -fno-math-errno -fno-trapping-math -fno-signed-zeros -fassociative-math -freciprocal-math"
      }
    },
    {
      "name": "gcc-coverage",
      "displayName": "GCC coverage",
      "inherits": "coverage-base",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "g++",
        "MPI_CXX_COMPILER": "/usr/bin/mpicxx.openmpi",
        "MPIEXEC_EXECUTABLE": "/usr/bin/mpiexec.openmpi",
        "RIFT_DEPENDENCIES_DIR": "${sourceDir}/.dependencies-gcc"
      }
    },
    {
      "name": "clang-coverage",
      "displayName": "Clang coverage",
      "inherits": "coverage-base",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug",          "configurePreset": "debug"          },
    { "name": "debug-tidy",     "configurePreset": "debug-tidy"     },
    { "name": "release",        "configurePreset": "release"        },
    { "name": "release-max",    "configurePreset": "release-max"    },
    { "name": "gcc-coverage",   "configurePreset": "gcc-coverage"   },
    { "name": "clang-coverage", "configurePreset": "clang-coverage" }
  ],
  "testPresets": [
    { "name": "debug",          "configurePreset": "debug",          "output": { "outputOnFailure": true } },
    { "name": "debug-tidy",     "configurePreset": "debug-tidy",     "output": { "outputOnFailure": true } },
    { "name": "release",        "configurePreset": "release",        "output": { "outputOnFailure": true } },
    { "name": "release-max",    "configurePreset": "release-max",    "output": { "outputOnFailure": true } },
    { "name": "gcc-coverage",   "configurePreset": "gcc-coverage",   "output": { "outputOnFailure": true } },
    {
      "name": "clang-coverage",
      "configurePreset": "clang-coverage",
      "environment": {
        "LLVM_PROFILE_FILE": "${sourceDir}/build/clang-coverage/profiles/%p-%m.profraw"
      },
      "output": { "outputOnFailure": true }
    }
  ]
}
